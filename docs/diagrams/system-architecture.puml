@startuml
title Lumen - Arquitectura general

top to bottom direction
skinparam shadowing false
skinparam linetype ortho

actor Usuario
actor Administrador

package "Aplicacion Next.js 16" as NextApp {
  rectangle "Storefront publico" as Storefront
  rectangle "Panel administrativo" as AdminPanel
}

rectangle "Modulos de dominio / src/features\n---\ncatalog\ncart\norders\ndiscounts\nsettings\nadmin" as Features

rectangle "Persistencia local / src/shared/storage\n---\ncreacion centralizada de repositorios\nrepositorios por dominio\nadaptadores sobre IndexedDB" as StorageLayer

package "Browser storage" as BrowserStorage {
  rectangle "IndexedDB\nproductos, carrito, pedidos,\ndescuentos y configuracion" as IndexedDB
  rectangle "sessionStorage\nsesion admin\nborrador checkout" as SessionStorage
  rectangle "localStorage\ncredenciales admin locales" as LocalStorage
}

rectangle "src/data/catalog.ts\nseed inicial del catalogo" as SeedCatalog

Usuario --> Storefront
Administrador --> AdminPanel

Storefront --> Features
AdminPanel --> Features
Features --> StorageLayer
StorageLayer --> BrowserStorage
SeedCatalog --> Features : render inicial del catalogo

note right of Storefront
Algunas vistas publicas arrancan con datos seed
y luego se rehidratan desde IndexedDB.
end note

note right of StorageLayer
El acceso a datos se expone mediante repositorios
por dominio, no mediante acceso directo a IndexedDB.
end note

note right of BrowserStorage
La persistencia es local al navegador.
No representa un backend compartido.
end note

@enduml
